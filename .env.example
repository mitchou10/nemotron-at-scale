# Host ports (change them if they are already taken)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090

# Application
APP_NAME=nemotron-backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+asyncpg://nemotron:nemotron@db:5432/nemotron
DATABASE_URL_TEST=postgresql+asyncpg://nemotron:nemotron@db:5432/nemotron_test

# Live transcription: the backend relays audio to ASR instances (nemo-speech serve, vosk_service)
ASR_ENABLED=false
# Comma-separated, in FILL ORDER: instances are filled one after the other. Each hostname is
# resolved to all replica IPs (docker compose --scale). "#N" sets that URL's per-instance limit.
# Services that are not started (compose profiles) are simply skipped.
ASR_URL=ws://asr-gpu:8080/v1/audio/transcriptions/realtime#16,ws://asr-cpu:8080/v1/audio/transcriptions/realtime#4,ws://asr-vosk:8080/v1/audio/transcriptions/realtime#12
# "dns": resolve each hostname to all its replica IPs; "static": use the URLs as they are
ASR_DISCOVERY=dns
# "database": save instance/stream state in PostgreSQL; "memory": keep it in the process
ASR_STATE_STORE=database
# Vosk (Kaldi) service (./vosk_service): same routes as nemo-speech, so it is a plain ws:// URL.
# VOSK_MODEL_NAME selects the model/language, VOSK_MAX_STREAMS its stream limit.
VOSK_MODEL_NAME=vosk-model-small-fr-0.22
# Container limits; the stream limit is derived: VOSK_CPUS x VOSK_STREAMS_PER_CPU (4 x 3 = 12)
VOSK_CPUS=4
VOSK_MEMORY=2g
VOSK_STREAMS_PER_CPU=3
# VOSK_MAX_STREAMS=12
# ASR_API_KEY=
# Default per-instance limit for URLs without "#N"
ASR_MAX_STREAMS_PER_INSTANCE=8
ASR_PROBE_INTERVAL_S=5
# Skip instances slower than this (ms) unless all free ones are; 0 = disabled
ASR_MAX_LATENCY_MS=0
# Resume on another instance if one drops: seconds of audio kept per stream (replayed on the
# new instance) and how many failovers one stream may use; 0 failovers disables resuming
ASR_BUFFER_SECONDS=30
ASR_MAX_FAILOVERS=2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
