# Host ports (change them if they are already taken)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
TTS_PORT=8081

# Application
APP_NAME=nemotron-backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+asyncpg://nemotron:nemotron@db:5432/nemotron
DATABASE_URL_TEST=postgresql+asyncpg://nemotron:nemotron@db:5432/nemotron_test

# Live transcription: the backend relays audio to ASR instances (nemo-speech serve, vosk_service)
ASR_ENABLED=false
# The instances register themselves in the backend (see REGISTRY_* below): there is no list of URLs.
# Fill order is the priority they announce (gpu 0, cpu 1, vosk 2); each announces its own stream limit.
# "database": save instance/stream state in PostgreSQL; "memory": keep it in the process
ASR_STATE_STORE=database
# Vosk (Kaldi) service (./vosk_service): same routes as nemo-speech; it registers itself.
# VOSK_MODEL_NAME selects the model/language, VOSK_MAX_STREAMS its stream limit.
VOSK_MODEL_NAME=vosk-model-small-fr-0.22
# Container limits; the stream limit is derived: VOSK_CPUS x VOSK_STREAMS_PER_CPU (4 x 3 = 12)
VOSK_CPUS=4
VOSK_MEMORY=2g
VOSK_STREAMS_PER_CPU=3
# VOSK_MAX_STREAMS=12
# ASR_API_KEY=
ASR_PROBE_INTERVAL_S=5
# Skip instances slower than this (ms) unless all free ones are; 0 = disabled
ASR_MAX_LATENCY_MS=0
# Resume on another instance if one drops: seconds of audio kept per stream (replayed on the
# new instance) and how many failovers one stream may use; 0 failovers disables resuming
ASR_BUFFER_SECONDS=30
ASR_MAX_FAILOVERS=2

# Registry: the workers (vosk, tts, nemo registrars) authenticate with this token. Change it, and
# leave it empty only for a throwaway local test (the registry is then open).
REGISTRY_TOKEN=change-me
# An instance silent for longer than this is no longer routed to
REGISTRY_TTL_S=30

# Admin interface (frontend, /api/v1/admin/*): the token asked at login. Change it, and leave it empty
# only for a throwaway local test (the statistics are then open).
ADMIN_TOKEN=change-me
# Audio streams and text-to-speech calls older than this are deleted
STATS_RETENTION_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Text to speech (./tts_service, Piper, OpenAI-compatible): start it with `docker compose --profile tts up`
# It registers itself; the backend relays POST /api/v1/audio/speech to the least loaded instance.
# TTS_API_KEY=
# Piper voices (comma-separated, the first is the default), downloaded on first start
TTS_VOICES=fr_FR-siwis-medium
# Syntheses running at once per tts_service instance (default: CPUs); 429 beyond
# TTS_MAX_REQUESTS=4
