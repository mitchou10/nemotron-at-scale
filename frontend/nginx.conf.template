# Rendered by the image entrypoint (envsubst): ${BACKEND_URL} and ${NGINX_LOCAL_RESOLVERS}
# (the DNS servers of the container, detected at start) are substituted.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The single-page application: any path that is not a file is handled by the router.
    # index.html is never cached, so a new release shows up at once.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }

    # Built files carry a hash in their name: they never change.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Same-origin API: the browser never talks to the backend directly (no CORS).
    # The backend name is resolved at request time, so nginx starts (and survives backend restarts)
    # even when the backend is not reachable yet.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
